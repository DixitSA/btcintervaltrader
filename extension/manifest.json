{
  "manifest_version": 3,
  "name": "btcbot overlay",
  "version": "0.1.6",
  "description": "Read-only overlay showing the local btcbot model's view of the KXBTC15M window you are looking at. Places no orders.",
  "browser_specific_settings": {
    "gecko": {
      "id": "btcbot-overlay@sahil.xyz",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://kalshi.com/*", "https://*.kalshi.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "btcbot overlay"
  }
}

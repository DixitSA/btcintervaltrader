{
  "manifest_version": 3,
  "name": "btcbot overlay",
  "version": "0.1.0",
  "description": "Read-only overlay showing the local btcbot model's view of the KXBTC15M window you are looking at. Places no orders.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://kalshi.com/*", "https://*.kalshi.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "btcbot overlay"
  }
}

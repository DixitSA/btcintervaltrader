# Copy to .env and fill in. NEVER commit .env.

# ============ KALSHI (venue: kalshi) ============
# Create an API key in Kalshi account settings; it gives you a key ID and
# downloads an RSA private key file. Public market data needs NO credentials,
# so `record` and `paper` work without any of this.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi-private-key.key
# Alternative to the path: paste the PEM contents directly.
KALSHI_PRIVATE_KEY=


# ============ POLYMARKET (venue: polymarket) ============
# Only needed for execution.backend: clob (direct EIP-712 signing).
# The Bullpen backend handles its own auth; leave these blank if you use it.

# Polygon wallet private key used to sign CLOB orders.
# Use a dedicated wallet funded with only what you can lose.
POLYMARKET_PRIVATE_KEY=

# 0 = the private key above holds the USDC directly (EOA)
# 1 = Polymarket email / Magic login  -> funds are in a PROXY wallet
# 2 = browser wallet via Polymarket UI -> funds are in a Gnosis Safe
#
# If you deposited through the Polymarket website, you are 1 or 2, NOT 0.
# Getting this wrong signs orders from an address with no balance.
POLYMARKET_SIGNATURE_TYPE=0

# Required when signature type is 1 or 2: the proxy/Safe address holding your
# USDC. Copy it from your Polymarket profile page.
POLYMARKET_FUNDER_ADDRESS=

# Override the config file's mode. paper | live
BTCBOT_MODE=paper

# Live trading is blocked unless this is exactly "yes".
# Do not set it until a paper run on real recorded data showed a positive
# net edge with |z| > 2 on a sample of several hundred trades.
BTCBOT_I_UNDERSTAND_REAL_MONEY=
